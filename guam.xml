    <project name="device_motorola_sm6225-common" path="device/motorola/sm6225-common" remote="halcyon-device" />
    <project name="device_motorola_guam" path="device/motorola/guam" remote="halcyon-device" />

    <!-- Kernel source tree -->
    <project name="kernel_motorola_sm6225" path="kernel/motorola/sm6225" remote="halcyon-device" />
    
    <!-- Vendor repositories -->
    <project name="vendor_motorola_sm6225-common" path="vendor/motorola/sm6225-common" remote="halcyon-blobs" />
    <project name="vendor_motorola_guam" path="vendor/motorola/guam" remote="halcyon-blobs" />

    <!-- Miscellaneous dependencies -->
    <!-- Temporarily allowed to fetch misc deps outside of halcyon remotes -->
